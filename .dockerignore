# Version control, CI and local tooling metadata
.git
.gitignore
.github
.githooks
.dockerignore
Dockerfile

# Secrets and local environment: the binaries only read the process
# environment, so nothing here may ever reach an image layer.
.env
.env.*

# Local build output (regenerated by `make build` / `make static`)
bin
dist
*.log

# Front-end dependencies (regenerated by `npm ci --prefix web`)
web/node_modules

# Test fixtures and test sources: they are not embedded into the binaries
testdata
**/*_test.go

# Documentation and local notes (chaves.md holds real receipt data)
README.md
docker-plan.md
chaves.md

# Editor / OS noise
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
