# Copy to .env and fill in real values. .env is gitignored; this file is a
# documented template only.
POSTGRES_USERNAME=dev
POSTGRES_PASSWORD=dev
DATABASE_NAME=meupreco

# Required — the PostgreSQL host the process connects to. It has no default on
# purpose: inside a container "localhost" is the container itself, not the
# database, and the failure mode is a confusing "connection refused".
#   * native/local run ......... localhost
#   * container on the same Docker network as the database ... its service
#     name (e.g. postgres)
#   * container reaching the database published on the Docker host ... the
#     Docker bridge gateway, e.g. 172.17.0.1
#     (docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}')
POSTGRES_HOST=localhost

# Required (>= 32 characters) — signs access and refresh tokens.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Required — seeds the initial admin account at boot (before the server starts
# serving) the first time the users table is empty. Use a strong, unique value:
# there is no password-change endpoint, and this variable is ignored on later
# boots once the admin exists. ADMIN_NAME is optional and defaults to the email
# local part.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# ADMIN_NAME=admin

# Optional overrides (defaults shown):
# PORT=8080
# LOG_LEVEL=info            # debug|info|warn|error
# LOG_FORMAT=pretty         # pretty|json
# CORS_ORIGINS=*            # comma-separated origins
# POSTGRES_PORT=5432
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h

# Public exposure hardening:
# KNOWN_PROXIES=127.0.0.1,::1  # comma-separated trusted proxy IPs, CIDRs,
#                              # hostnames or http(s) URLs (resolved at startup)
# ENABLE_REGISTRATION=false    # true to accept POST /api/v1/auth/register
# ENABLE_DOCS=false            # true to serve /docs/ and /openapi.*

# SEFAZ portal fetcher tuning (politeness / anti-ban):
# SEFAZ_FETCH_RPS=1         # requests per second
# SEFAZ_MIN_INTERVAL=10s    # minimum spacing between fetches (overrides RPS when slower)
# SEFAZ_MAX_RETRIES=1       # attempts per receipt (>= 1); 1 = one attempt, zero retries
# SEFAZ_TIMEOUT=30s         # per-request timeout (retries included)
# SEFAZ_BACKOFF_BASE=200ms  # starting exponential retry delay
# SEFAZ_BACKOFF_CAP=2s      # cap per exponential retry delay
# SEFAZ_COOLDOWN=1m         # wait after an anti-bot/rate-limit rejection (capped at 15m)
# SEFAZ_USER_AGENT="MeuPreco/0.1"  # printable ASCII, max 256 bytes; provided value is trimmed
# SEFAZ_BASE_URL=           # override the SP consultation QR URL (optional)

# Draft lifecycle:
# PREVIEWS_TTL=15m          # how long a pending draft stays valid
# PREVIEW_GC_INTERVAL=5m    # background sweep period (plus the write-time sweep)

# Rate limiting (0 disables the bucket):
# RATE_LIMIT_IP_RPS=5       # global per-IP refill rate
# RATE_LIMIT_IP_BURST=300   # global per-IP burst
# RATE_LIMIT_USER_RPS=20    # per-user refill rate (authenticated routes)
# RATE_LIMIT_USER_BURST=1000
# RATE_LIMIT_AUTH_IP_RPS=0.2   # stricter per-IP refill rate for auth routes
# RATE_LIMIT_AUTH_IP_BURST=10  # stricter per-IP burst for auth routes

# Login brute-force throttle (per account):
# LOGIN_MAX_FAILURES=10     # failed logins allowed inside the window
# LOGIN_WINDOW=15m          # Go duration > 0

# Optional best-effort Open Food Facts enrichment of gtin_new drafts (off by
# default: ingestion stays offline-first and deterministic):
# ENRICH_OFF=false
