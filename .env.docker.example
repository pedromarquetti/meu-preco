# MeuPreço Docker Compose example configuration
# Copy to .env from .env.docker.example and fill in real values.
# This file is gitignored.

# PostgreSQL credentials (use strong values in production)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# Database name
POSTGRES_DB=meupreco

# Required — the PostgreSQL host the process connects to.
# Inside Compose, use the service name "postgres" instead of "localhost".
POSTGRES_HOST=postgres

# Required (>= 32 characters) — signs access and refresh tokens
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Required — seeds the initial admin account at boot (before the server starts
# serving) the first time the users table is empty. Change the password after
# the first login. ADMIN_NAME is optional and defaults to the email local part.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# ADMIN_NAME=admin

# Optional overrides (defaults shown):
# PORT=8080
# LOG_LEVEL=info            # debug|info|warn|error
# LOG_FORMAT=pretty         # pretty|json
# CORS_ORIGINS=*            # comma-separated origins
# POSTGRES_PORT=5432
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h

# SEFAZ portal fetcher tuning (politeness / anti-ban):
# SEFAZ_FETCH_RPS=1         # requests per second
# SEFAZ_MAX_RETRIES=3       # fetch attempts per receipt (>= 1)
# SEFAZ_TIMEOUT=30s         # per-request timeout (retries included)
# SEFAZ_BACKOFF_BASE=200ms  # starting exponential retry delay
# SEFAZ_BACKOFF_CAP=2s      # cap per exponential retry delay
# SEFAZ_BASE_URL=           # override the SP consultation QR URL (optional)

# Draft lifecycle:
# PREVIEWS_TTL=15m          # how long a pending draft stays valid
# PREVIEW_GC_INTERVAL=5m    # background sweep period (plus the write-time sweep)

# Rate limiting (0 disables the bucket):
# RATE_LIMIT_IP_RPS=5       # global per-IP refill rate
# RATE_LIMIT_IP_BURST=300   # global per-IP burst
# RATE_LIMIT_USER_RPS=20    # per-user refill rate (authenticated routes)
# RATE_LIMIT_USER_BURST=1000

# Optional best-effort Open Food Facts enrichment of gtin_new drafts (off by
# default: ingestion stays offline-first and deterministic):
# ENRICH_OFF=false

# Image configuration:
# Use a locally built image by default. To use a published image, set:
#   IMAGE_TAG=v1.0.0
#   MEUPRECO_IMAGE=your-registry/meupreco

# User/Group ID mapping (Docker Compose user: key)
# The app and migrate services share the same image (built with UID 10001).
# Changing APP_UID/APP_GID requires rebuilding the image with --build-arg UID=... GID=...
APP_UID=10001
APP_GID=10001
